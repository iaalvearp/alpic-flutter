NODE_ENV=development
HOST=127.0.0.1
PORT=3000
API_PREFIX=/api/v1

# Backend Supabase connection used by persistence and authentication.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=alpics-images

# Optional issuer/audience settings reserved for future JWT policy checks.
JWT_ISSUER=
JWT_AUDIENCE=

# Comma-separated browser origins. Empty means no browser origin is allowed.
CORS_ORIGINS=

# Optional generic external API configuration.
EXTERNAL_API_BASE_URL=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
EXTERNAL_API_TIMEOUT_MS=5000
